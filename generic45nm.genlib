GATE $_NOT_ 1.0 Y=!A;
  PIN A INV 0 999 0.009 0 0.009 0
GATE $_AND_ 1.0 Y=A*B;
  PIN A NONINV 0 999 0.018 0 0.016 0
  PIN B NONINV 0 999 0.018 0 0.016 0
GATE $_OR_ 1.0 Y=A+B;
  PIN A NONINV 0 999 0.019 0 0.017 0
  PIN B NONINV 0 999 0.019 0 0.017 0
GATE $_XOR_ 1.0 Y=A*!B+!A*B;
  PIN A UNKNOWN 0 999 0.028 0 0.028 0
  PIN B UNKNOWN 0 999 0.028 0 0.028 0
GATE $_XNOR_ 1.0 Y=A*B+!A*!B;
  PIN A UNKNOWN 0 999 0.028 0 0.028 0
  PIN B UNKNOWN 0 999 0.028 0 0.028 0
GATE $_NAND_ 1.0 Y=!(A*B);
  PIN A INV 0 999 0.014 0 0.017 0
  PIN B INV 0 999 0.014 0 0.017 0
GATE $_NOR_ 1.0 Y=!(A+B);
  PIN A INV 0 999 0.017 0 0.014 0
  PIN B INV 0 999 0.017 0 0.014 0
GATE $_ANDNOT_ 1.0 Y=A*!B;
  PIN A NONINV 0 999 0.018 0 0.016 0
  PIN B INV 0 999 0.018 0 0.016 0
GATE $_ORNOT_ 1.0 Y=A+!B;
  PIN A NONINV 0 999 0.019 0 0.017 0
  PIN B INV 0 999 0.019 0 0.017 0
GATE $_MUX_ 1.0 Y=!S*A+S*B;
  PIN A NONINV 0 999 0.022 0 0.022 0
  PIN B NONINV 0 999 0.022 0 0.022 0
  PIN S UNKNOWN 0 999 0.028 0 0.028 0
GATE BUF 0.5 Y=A;
  PIN A NONINV 0 999 0.005 0 0.005 0

# Constant tie cells
GATE ONE  0.0 Y=CONST1;
  PIN * NONINV 0 999 0 0 0 0
GATE ZERO 0.0 Y=CONST0;
  PIN * NONINV 0 999 0 0 0 0
